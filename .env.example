# PostgreSQL connection string used by Prisma.
# Host port is 5433 to avoid clashing with a default local PostgreSQL on 5432
# (matches docker-compose.yml). Adjust if you mapped a different host port.
DATABASE_URL="postgresql://audit:audit@localhost:5433/audit_dashboard?schema=public"

# Optional: hooks for AI document processing microservices.
# When ANTHROPIC_API_KEY is set, uploaded documents are parsed via the Claude
# OCR provider; otherwise a deterministic stub parser is used.
OCR_SERVICE_URL=""
ANTHROPIC_API_KEY=""

# Auth: secret used to sign session JWTs (>= 16 chars). Generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Set to "true" to require authentication on API routes and pages.
# Leave unset/false to keep the public demo (in-memory data) accessible.
AUTH_REQUIRED="false"
