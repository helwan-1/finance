# -----------------------------------------------------------------------------
# Database (two roles — see prisma/migrations/*_g1_security_rls)
# -----------------------------------------------------------------------------
# RUNTIME connection: the NON-owner `audit_app` role. It is subject to
# PostgreSQL Row-Level Security, so tenant isolation holds even if an
# application query forgets a filter. The app MUST connect with this role.
DATABASE_URL="postgresql://audit_app:CHANGE_ME@localhost:5433/audit_dashboard?schema=public"

# MIGRATIONS/seed connection: the schema OWNER (bypasses RLS) so provisioning
# and the first-firm insert work. For local single-role dev you may point this
# at the same URL as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://audit_owner:CHANGE_ME@localhost:5433/audit_dashboard?schema=public"

# After migrating, enable login on the runtime role (out of band, no secret in VCS):
#   ALTER ROLE audit_app LOGIN PASSWORD '<strong-random>';

# BACKGROUND DISPATCH connection: the locator-only `audit_dispatch` role. Used ONLY
# by the background runtime (npm run dispatch) to call app_locate_runnable_work().
# It has EXECUTE on the locator + schema USAGE and NOTHING else (no table grants, no
# BYPASSRLS). Enable its login out of band, no secret in VCS:
#   ALTER ROLE audit_dispatch LOGIN PASSWORD '<strong-random>';
DISPATCH_DATABASE_URL="postgresql://audit_dispatch:CHANGE_ME@localhost:5433/audit_dashboard?schema=public"
# Optional: background dispatcher poll interval (ms). Default 5000.
DISPATCH_POLL_INTERVAL_MS="5000"

# -----------------------------------------------------------------------------
# Authentication (G1 — fail-closed)
# -----------------------------------------------------------------------------
# Secret used to sign session JWTs. REQUIRED. Generate with:
#   openssl rand -base64 48
# Production requires >= 32 chars and rejects known placeholder values.
AUTH_SECRET="change-me-to-a-long-random-string"

# Non-production ONLY: set "true" to require authentication (mirror production).
# In production authentication is ALWAYS enforced regardless of this value —
# there is no demo/no-auth path in production (fail-closed).
AUTH_REQUIRED="false"

# Optional: extra allowed browser origins for state-changing requests
# (comma-separated). Same-origin requests are always allowed.
ALLOWED_ORIGINS=""

# -----------------------------------------------------------------------------
# G2 source-file custody (provider-neutral storage)
# -----------------------------------------------------------------------------
# Object store root for the filesystem adapter. MUST be an absolute, PERSISTENT
# path (a mounted volume) in production — RETAINED custody must not rest on an
# ephemeral location. Production fails closed if this is unset or under /tmp.
# Dev/test may use /tmp.
STORAGE_PROVIDER="local-fs"
STORAGE_LOCAL_DIR="/var/lib/sarat/object-store"

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# When ANTHROPIC_API_KEY is set, uploaded documents are parsed via the Claude
# OCR provider; otherwise a deterministic stub parser is used. This is the only
# outbound data path.
OCR_SERVICE_URL=""
ANTHROPIC_API_KEY=""
