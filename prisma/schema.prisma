// Financial Audit Dashboard — Prisma schema
// -----------------------------------------------------------------------------
// Design principles:
//   * Absolute multi-tenant isolation. Every tenant-owned row carries
//     auditFirmId, and engagement-scoped rows also carry engagementId.
//     Application queries MUST always filter by these.
//   * Financial precision: ALL monetary amounts use @db.Decimal(15, 2).
//     Never handled as JS floats in calculations.
//   * Immutable audit trail via the AuditLog model.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: the NON-owner `audit_app` role, which is subject to
  // Row-Level Security (tenant isolation). See migration *_g1_security_rls.
  url       = env("DATABASE_URL")
  // Migrations/introspection connect as the schema owner (bypasses RLS) so
  // provisioning and the first-firm insert work. For local single-role dev,
  // point both at the same URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN // audit firm administrator
  PARTNER // engagement partner (sign-off authority)
  MANAGER // engagement manager
  SENIOR // senior auditor
  STAFF // staff auditor
  REVIEWER // read-only reviewer
}

enum DocumentType {
  INVOICE
  BANK_STATEMENT
  VAT_RETURN
  GENERAL_LEDGER
  PURCHASE_ORDER
  RECEIPT
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING // OCR / parsing in progress
  PARSED
  FAILED
  ARCHIVED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionSource {
  LEDGER
  BANK
  INVOICE
  MANUAL
}

enum ReconciliationStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

enum MatchStatus {
  MATCHED
  PARTIAL
  UNMATCHED
  DISPUTED
}

// Rule codes for anomaly detection. Kept as an enum so the FilterBar can
// present a stable, translatable set of rule categories.
enum AnomalyRuleCode {
  BENFORD_DEVIATION // Benford's Law first-digit deviation
  DUPLICATE_EXACT // exact duplicate transaction
  DUPLICATE_NEAR // near-duplicate within time window
  OFF_HOURS_ENTRY // entry posted outside business hours
  WEEKEND_ENTRY // entry posted on weekend
  VAT_DISCREPANCY // VAT amount mismatch
  ROUND_AMOUNT // suspicious round-number amount
  UNRECONCILED // could not be reconciled
  THRESHOLD_AVOIDANCE // amount just below an authorization limit (structuring)
  GAP_SEQUENCE // missing number in a reference sequence
  DENYLIST_PARTY // counterparty / account on a deny list
  MISSING_FIELD // required field absent (e.g. no VAT number, no document)
  BACKDATED_ENTRY // value date precedes posting by too long / future-dated
  CUSTOM_RULE // produced by a user-defined AuditRule
}

// Category a user-defined audit rule belongs to (for grouping in the UI).
enum RuleCategory {
  NUMERIC // thresholds, comparisons, round amounts, VAT ratio
  PARTY // counterparty / account allow & deny lists, missing ids
  TIMING // off-hours, weekend, period, future / backdated
  AGGREGATE // duplicates, counts, sums, split / structuring
}

enum AnomalySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AnomalyStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED // false positive
  ESCALATED
}

enum AuditAction {
  VIEW_DOCUMENT
  DOWNLOAD_DOCUMENT
  RESOLVE_ANOMALY
  DISMISS_ANOMALY
  ESCALATE_ANOMALY
  EXPORT_DATA
  RUN_RECONCILIATION
  RUN_ANALYSIS
  LOGIN
  LOGOUT
}

// ----------------------------------------------------------------------------
// G2 — Source custody, dataset & import lineage (enums)
// ----------------------------------------------------------------------------

enum SourceStorageProvider {
  NONE // no bytes retained (legacy / metadata-only)
  OBJECT_STORE // provider-neutral object store behind the storage port
}

enum CustodyStatus {
  RETAINED // bytes actually stored & retrievable (required for new imports)
  METADATA_ONLY // metadata kept, bytes never retained (legacy documents)
  NOT_RETAINED // no bytes and no artifact evidence (legacy container)
  TOMBSTONED // logically deleted; blocked while legalHold is true
}

// Provider-neutral processing provenance — records what happened, not permission.
enum ProcessingBoundary {
  NONE
  INTERNAL
  EXTERNAL
}

enum DatasetKind {
  GENERAL_LEDGER
  TRIAL_BALANCE
  BANK
  OTHER
}

enum LineageClass {
  VERIFIED
  PARTIAL_LINEAGE
  UNKNOWN_LINEAGE
  LEGACY_UNVERIFIED
}

enum ImportFormat {
  CSV
  XLSX
}

enum ImportBatchStatus {
  RECEIVED
  PROFILING
  VALIDATING
  READY // halted — explicit auditor confirmation required (C8)
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
  CANCELLED
}

enum ImportAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DatasetStatus {
  PENDING
  COMPLETED
  COMPLETED_WITH_ISSUES
  FAILED
}

enum ImportedRecordStatus {
  ACCEPTED
  ACCEPTED_WITH_WARNING
  REJECTED
}

enum ImportIssueScope {
  FILE
  PROFILE
  MAPPING
  ROW
  FIELD
}

enum ImportIssueSeverity {
  ERROR
  WARNING
  INFO
}

// ----------------------------------------------------------------------------
// Tenancy root
// ----------------------------------------------------------------------------

model AuditFirm {
  id        String   @id @default(cuid())
  name      String
  nameAr    String // Arabic display name
  licenseNo String   @unique
  // Firm-level audit configuration (VAT rate, business hours, weekend, ...).
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  clientCompanies ClientCompany[]
  engagements     AuditEngagement[]
  documents       Document[]
  transactions    Transaction[]
  reconciliations ReconciliationSession[]
  anomalies       AnomalyFlag[]
  auditLogs       AuditLog[]
  auditRules      AuditRule[]

  @@map("audit_firms")
}

model User {
  id           String   @id @default(cuid())
  auditFirmId  String
  email        String
  fullName     String
  fullNameAr   String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  // bcrypt hash; never returned to the client.
  passwordHash String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditFirm         AuditFirm          @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  resolvedAnomalies AnomalyFlag[]      @relation("AnomalyResolver")
  auditLogs         AuditLog[]
  engagementMembers EngagementMember[]

  // Email is unique within a firm, not globally.
  @@unique([auditFirmId, email])
  @@index([auditFirmId])
  @@map("users")
}

model ClientCompany {
  id          String   @id @default(cuid())
  auditFirmId String
  name        String
  nameAr      String
  vatNumber   String? // 15-digit ZATCA VAT registration number
  crNumber    String? // commercial registration number
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditFirm   AuditFirm         @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagements AuditEngagement[]

  @@unique([auditFirmId, vatNumber])
  @@index([auditFirmId])
  @@map("client_companies")
}

model AuditEngagement {
  id              String   @id @default(cuid())
  auditFirmId     String
  clientCompanyId String
  title           String
  titleAr         String
  fiscalYear      Int
  periodStart     DateTime
  periodEnd       DateTime
  currency        String   @default("SAR")
  isClosed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditFirm       AuditFirm               @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  clientCompany   ClientCompany           @relation(fields: [clientCompanyId], references: [id], onDelete: Cascade)
  members         EngagementMember[]
  documents       Document[]
  transactions    Transaction[]
  reconciliations ReconciliationSession[]
  anomalies       AnomalyFlag[]
  auditLogs       AuditLog[]
  auditRules      AuditRule[]

  @@index([auditFirmId])
  @@index([clientCompanyId])
  @@map("audit_engagements")
}

// Join model: which users are assigned to which engagement.
model EngagementMember {
  id           String   @id @default(cuid())
  engagementId String
  userId       String
  assignedAt   DateTime @default(now())

  engagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([engagementId, userId])
  @@index([userId])
  @@map("engagement_members")
}

// ----------------------------------------------------------------------------
// Documents & transactions
// ----------------------------------------------------------------------------

model Document {
  id           String         @id @default(cuid())
  auditFirmId  String
  engagementId String
  type         DocumentType
  status       DocumentStatus @default(UPLOADED)
  fileName     String
  storageKey   String // object-storage key (S3/GCS)
  mimeType     String
  sizeBytes    Int
  pageCount    Int?
  // Raw structured output from OCR/parsing (Textract/PaddleOCR/Claude).
  parsedData   Json?
  uploadedAt   DateTime       @default(now())
  parsedAt     DateTime?
  // G2 lineage bridge: a Document may reference the SourceFile whose bytes
  // produced it. Scalar-only (DB FK added in the G2 migration). Nullable.
  sourceFileId String?

  auditFirm    AuditFirm       @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement   AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([auditFirmId])
  @@index([engagementId, status])
  @@index([sourceFileId])
  @@map("documents")
}

model Transaction {
  id               String  @id @default(cuid())
  auditFirmId      String
  engagementId     String
  documentId       String?
  // G2 lineage bridge (transitional for the flat model — IC-2 / ADR-G2-11):
  //   importedRecordId is authoritative row lineage; unique among non-nulls so
  //   ImportedRecord -> 0..1 Transaction holds for the current flat model. G3
  //   may map one ImportedRecord to many canonical lines via separate entities.
  //   datasetId is a denormalized, immutable index key. DB FKs added in the G2
  //   migration (composite tenant FKs). Both nullable for legacy rows.
  datasetId        String?
  importedRecordId String?

  reference   String // voucher / invoice / statement line reference
  description String
  // MONETARY AMOUNTS — always Decimal(15, 2). Never JS float.
  amount      Decimal           @db.Decimal(15, 2)
  vatAmount   Decimal?          @db.Decimal(15, 2)
  currency    String            @default("SAR")
  type        TransactionType
  source      TransactionSource

  counterparty String?
  account      String? // GL account code
  // postedAt is when it was recorded in the system (used for off-hours checks).
  postedAt     DateTime
  // valueDate is the accounting/value date.
  valueDate    DateTime
  createdAt    DateTime @default(now())

  auditFirm  AuditFirm       @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  document   Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  matchesAsSource ReconciliationMatch[] @relation("MatchSource")
  matchesAsTarget ReconciliationMatch[] @relation("MatchTarget")
  anomalies       AnomalyFlag[]

  // IC-2: at most one Transaction per ImportedRecord (non-null unique).
  @@unique([importedRecordId])
  @@index([auditFirmId])
  @@index([engagementId, postedAt])
  @@index([engagementId, source])
  @@index([datasetId])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// Reconciliation
// ----------------------------------------------------------------------------

model ReconciliationSession {
  id           String               @id @default(cuid())
  auditFirmId  String
  engagementId String
  name         String
  status       ReconciliationStatus @default(DRAFT)
  // Sources being reconciled, e.g. "BANK" vs "LEDGER".
  sourceA      TransactionSource
  sourceB      TransactionSource
  matchedCount Int                  @default(0)
  totalCount   Int                  @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())

  auditFirm  AuditFirm             @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement AuditEngagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  matches    ReconciliationMatch[]

  @@index([auditFirmId])
  @@index([engagementId, status])
  @@map("reconciliation_sessions")
}

model ReconciliationMatch {
  id          String      @id @default(cuid())
  sessionId   String
  sourceTxnId String
  targetTxnId String?
  status      MatchStatus @default(UNMATCHED)
  // Confidence score 0.00 - 1.00 for fuzzy matches.
  confidence  Decimal     @db.Decimal(5, 4)
  amountDelta Decimal?    @db.Decimal(15, 2)
  createdAt   DateTime    @default(now())

  session   ReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceTxn Transaction           @relation("MatchSource", fields: [sourceTxnId], references: [id], onDelete: Cascade)
  targetTxn Transaction?          @relation("MatchTarget", fields: [targetTxnId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@map("reconciliation_matches")
}

// ----------------------------------------------------------------------------
// Anomalies
// ----------------------------------------------------------------------------

model AnomalyFlag {
  id            String  @id @default(cuid())
  auditFirmId   String
  engagementId  String
  transactionId String?

  ruleCode      AnomalyRuleCode
  severity      AnomalySeverity
  status        AnomalyStatus   @default(OPEN)
  title         String
  titleAr       String
  description   String
  descriptionAr String
  // Structured evidence for the flag (e.g. Benford stats, matched pair ids).
  evidence      Json?
  // Numeric score used for ranking within the feed.
  score         Decimal         @db.Decimal(5, 2)

  // Set when this flag was produced by a user-defined rule (ruleCode CUSTOM_RULE).
  auditRuleId String?

  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  auditFirm   AuditFirm       @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement  AuditEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  resolvedBy  User?           @relation("AnomalyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  auditRule   AuditRule?      @relation(fields: [auditRuleId], references: [id], onDelete: SetNull)

  @@index([auditFirmId])
  @@index([engagementId, status])
  @@index([engagementId, severity])
  @@index([engagementId, ruleCode])
  @@index([engagementId, detectedAt])
  @@index([auditRuleId])
  @@map("anomaly_flags")
}

// ----------------------------------------------------------------------------
// User-defined audit rules (deterministic rules engine)
// ----------------------------------------------------------------------------

model AuditRule {
  id           String  @id @default(cuid())
  auditFirmId  String
  // Null → a firm-wide rule applied to every engagement; set → engagement-scoped.
  engagementId String?

  name          String
  nameAr        String
  // Short human code shown on findings (e.g. "LIMIT-100K").
  code          String
  category      RuleCategory
  severity      AnomalySeverity @default(MEDIUM)
  enabled       Boolean         @default(true)
  descriptionAr String?
  // Typed rule definition (discriminated union), evaluated by the engine.
  definition    Json

  // G4 (additive): firm-stable semantic key + current version pointer. Nullable
  // for existing rows (backfill deferred to a later phase); NULLs are distinct
  // so the firm-scoped unique holds for un-keyed legacy rows.
  key              String?
  currentVersionId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditFirm  AuditFirm        @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement AuditEngagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  anomalies  AnomalyFlag[]

  @@unique([auditFirmId, key])
  @@index([auditFirmId, enabled])
  @@index([engagementId])
  @@map("audit_rules")
}

// ----------------------------------------------------------------------------
// Immutable audit trail
// ----------------------------------------------------------------------------

model AuditLog {
  id           String  @id @default(cuid())
  auditFirmId  String
  engagementId String?
  userId       String

  action     AuditAction
  // Type + id of the affected entity (e.g. "AnomalyFlag", "<id>").
  entityType String
  entityId   String?
  // Arbitrary context (old/new values, filters used on export, etc.).
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  auditFirm  AuditFirm        @relation(fields: [auditFirmId], references: [id], onDelete: Cascade)
  engagement AuditEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([auditFirmId, createdAt])
  @@index([engagementId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// G2 — Source custody, dataset & import lineage (9 tables)
// Relationless models: FKs (single + composite tenant FKs) and RLS are added in
// the G2 migration SQL. Every table carries auditFirmId directly (G1 parity) and
// exposes @@unique([auditFirmId, id]) as the target of composite tenant FKs.
// ----------------------------------------------------------------------------

model SourceFile {
  id                  String                @id @default(cuid())
  auditFirmId         String
  engagementId        String?
  clientCompanyId     String?
  originalFileName    String
  mimeType            String
  sizeBytes           BigInt
  sha256              String? // null only for legacy / no-artifact
  uploadedById        String?
  uploadedAt          DateTime              @default(now())
  storageProvider     SourceStorageProvider @default(NONE)
  storageBucket       String?
  storageObjectKey    String?
  storageVersion      String?
  custodyStatus       CustodyStatus
  processingBoundary  ProcessingBoundary    @default(NONE)
  processorRef        String?
  retentionPolicy     String?
  legalHold           Boolean               @default(false)
  tombstonedAt        DateTime?
  legacyStorageKeyRaw String?
  createdAt           DateTime              @default(now())

  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([engagementId])
  @@index([auditFirmId, sha256])
  @@index([auditFirmId, custodyStatus])
  @@map("source_files")
}

model ImportProfile {
  id                   String       @id @default(cuid())
  auditFirmId          String
  clientCompanyId      String?
  name                 String
  format               ImportFormat
  encoding             String
  delimiter            String?
  sheet                String?
  headerRow            Int
  locale               String
  dateInterpretation   String
  numberInterpretation String
  parserVersion        String
  normalizerVersion    String
  profileHash          String
  createdById          String?
  createdAt            DateTime     @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, profileHash])
  @@index([auditFirmId])
  @@index([auditFirmId, clientCompanyId])
  @@map("import_profiles")
}

model ImportMapping {
  id               String      @id @default(cuid())
  auditFirmId      String
  clientCompanyId  String?
  name             String
  datasetKind      DatasetKind
  currentVersionId String?
  createdAt        DateTime    @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, clientCompanyId, name, datasetKind])
  @@index([auditFirmId])
  @@map("import_mappings")
}

model ImportMappingVersion {
  id                    String   @id @default(cuid())
  auditFirmId           String
  importMappingId       String
  version               Int
  mapJson               Json
  targetFieldSetVersion String
  mappingHash           String
  createdById           String?
  createdAt             DateTime @default(now())

  @@unique([auditFirmId, id])
  @@unique([importMappingId, version])
  @@unique([auditFirmId, mappingHash])
  @@index([auditFirmId])
  @@index([importMappingId])
  @@map("import_mapping_versions")
}

model ImportBatch {
  id                     String            @id @default(cuid())
  auditFirmId            String
  engagementId           String
  sourceFileId           String? // nullable: legacy container has no file (C11)
  importProfileId        String?
  importMappingVersionId String?
  datasetKind            DatasetKind
  status                 ImportBatchStatus @default(RECEIVED)
  idempotencyKey         String
  effectiveProfileJson   Json?
  effectiveProfileHash   String?
  resultDatasetId        String? // set once on success (immutable)
  rowsTotal              Int               @default(0)
  rowsAccepted           Int               @default(0)
  rowsRejected           Int               @default(0)
  startedById            String?
  startedAt              DateTime          @default(now())
  completedAt            DateTime?
  failureReason          String?

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, idempotencyKey])
  @@index([auditFirmId])
  @@index([engagementId, status])
  @@index([sourceFileId])
  @@map("import_batches")
}

model ImportAttempt {
  id            String              @id @default(cuid())
  auditFirmId   String
  importBatchId String
  attemptNo     Int
  status        ImportAttemptStatus @default(RUNNING)
  startedById   String?
  startedAt     DateTime            @default(now())
  endedAt       DateTime?
  confirmedById String?
  confirmedAt   DateTime?
  failureReason String?

  @@unique([auditFirmId, id])
  @@unique([importBatchId, attemptNo])
  @@index([auditFirmId])
  @@index([importBatchId])
  @@map("import_attempts")
}

model Dataset {
  id                String        @id @default(cuid())
  auditFirmId       String
  engagementId      String
  clientCompanyId   String?
  importBatchId     String
  importAttemptId   String
  sourceFileId      String? // nullable: legacy container (C11)
  kind              DatasetKind
  label             String
  datasetHash       String? // null until finalized / legacy
  lineageClass      LineageClass  @default(VERIFIED)
  status            DatasetStatus @default(PENDING)
  rowCountTotal     Int           @default(0)
  rowCountAccepted  Int           @default(0)
  rowCountRejected  Int           @default(0)
  normalizerVersion String
  finalizedAt       DateTime?
  createdAt         DateTime      @default(now())

  @@unique([auditFirmId, id])
  @@unique([importAttemptId])
  @@index([auditFirmId])
  @@index([engagementId, kind, status])
  @@index([datasetHash])
  @@map("datasets")
}

model ImportedRecord {
  id             String               @id @default(cuid())
  auditFirmId    String
  datasetId      String
  importBatchId  String
  sourceFileId   String?
  sourceRowNo    Int
  rawCells       Json // lossless positional [{i,h,v}] (C5)
  rawHash        String
  normalizedJson Json?
  status         ImportedRecordStatus

  @@unique([auditFirmId, id])
  @@unique([datasetId, sourceRowNo])
  @@index([auditFirmId])
  @@index([datasetId, status])
  @@index([auditFirmId, rawHash])
  @@map("imported_records")
}

model ImportIssue {
  id               String              @id @default(cuid())
  auditFirmId      String
  importBatchId    String
  importAttemptId  String?
  importedRecordId String?
  datasetId        String?
  scope            ImportIssueScope
  field            String?
  severity         ImportIssueSeverity
  code             String
  message          String
  rawValue         String?
  blocking         Boolean             @default(false)
  createdAt        DateTime            @default(now())

  @@unique([auditFirmId, id])
  @@index([auditFirmId, severity])
  @@index([importBatchId])
  @@index([importedRecordId])
  @@map("import_issues")
}

// ============================================================================
// G3 — Canonical Accounting Foundation (imported accounting EVIDENCE for audit)
// Frozen design, ADR-G3-01..08. Fact classes:
//   * SOURCE FACT / immutable  — SourceAccountingContext, DatasetAccount,
//     JournalEntry, JournalLine, TrialBalance, TrialBalanceRow.
//     audit_app holds SELECT + INSERT only (UPDATE/DELETE revoked in the G3
//     migration; construct-then-finalize inside the import transaction).
//   * MUTABLE WORKING MASTER   — AccountingScope, Account, FiscalPeriod.
//   * VERSIONED AUDIT INTERPRETATION — AccountMapping, AccountMappingVersion
//     (immutable history; supersession stamps the pointer/prior-version only).
// Models are relationless (as G2): every FK — simple + composite tenant — lives
// in the G3 migration SQL. Canonical money is Decimal(24,6); rate Decimal(24,12).
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  OTHER
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum FiscalPeriodType {
  MONTH
  QUARTER
  YEAR
  ADJUSTMENT
}

enum SourceIdentityOrigin {
  PROFILE
  MAPPING
  ROW
}

enum JournalGroupingCapability {
  EXPLICIT_ENTRY_AND_LINE_ID
  EXPLICIT_ENTRY_ID
  NO_RELIABLE_ENTRY_ID
}

enum JournalGroupingBasis {
  SOURCE_ASSERTED_ENTRY_LINE
  SOURCE_ASSERTED_ENTRY
}

enum BalanceCapability {
  AVAILABLE
  PARTIAL
  NOT_AVAILABLE
}

enum BalanceStatus {
  BALANCED
  UNBALANCED
  NOT_EVALUABLE
}

enum MonetaryBasis {
  TRANSACTION
  FUNCTIONAL
}

enum AccountMappingBasis {
  EXACT_CODE_IN_SCOPE
  AUDITOR_ASSERTED
  IMPORT_CONFIRMED
}

// --- MUTABLE WORKING MASTER --------------------------------------------------

model AccountingScope {
  id              String   @id @default(cuid())
  auditFirmId     String
  clientCompanyId String
  key             String // stable scope key within a client (e.g. system:entity:ledger)
  label           String?
  sourceSystem    String?
  sourceEntity    String?
  sourceLedger    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, clientCompanyId, key])
  @@index([auditFirmId])
  @@index([auditFirmId, clientCompanyId])
  @@map("accounting_scopes")
}

model Account {
  id                String         @id @default(cuid())
  auditFirmId       String
  clientCompanyId   String
  accountingScopeId String
  accountCode       String
  accountName       String
  accountType       AccountType?
  normalBalance     NormalBalance?
  parentAccountId   String?
  status            AccountStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // C3: same accountCode may coexist under different scopes (no client-global unique).
  @@unique([auditFirmId, id])
  @@unique([auditFirmId, clientCompanyId, accountingScopeId, accountCode])
  @@index([auditFirmId])
  @@index([auditFirmId, clientCompanyId, accountingScopeId, accountCode])
  @@map("accounts")
}

model FiscalPeriod {
  id              String           @id @default(cuid())
  auditFirmId     String
  clientCompanyId String
  engagementId    String?
  fiscalYear      Int
  periodNo        Int
  periodKey       String
  startDate       DateTime
  endDate         DateTime
  periodType      FiscalPeriodType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, clientCompanyId, fiscalYear, periodNo])
  @@index([auditFirmId])
  @@index([auditFirmId, clientCompanyId, fiscalYear])
  @@map("fiscal_periods")
}

// --- SOURCE FACT / immutable -------------------------------------------------

model SourceAccountingContext {
  id                  String               @id @default(cuid())
  auditFirmId         String
  datasetId           String
  sourceSystem        String?
  sourceSystemVersion String?
  sourceEntity        String?
  sourceLedger        String?
  capturedFrom        SourceIdentityOrigin
  createdAt           DateTime             @default(now())

  // Deterministic one-per-(dataset,tuple) enforced by a COALESCE unique index
  // in the G3 migration (context-zero = all-null attributes).
  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([auditFirmId, datasetId])
  @@index([auditFirmId, sourceSystem, sourceEntity, sourceLedger])
  @@map("source_accounting_contexts")
}

model DatasetAccount {
  id                        String   @id @default(cuid())
  auditFirmId               String
  datasetId                 String
  sourceAccountingContextId String
  sourceAccountCode         String
  sourceAccountName         String?
  firstImportedRecordId     String
  occurrenceCount           Int      @default(1)
  createdAt                 DateTime @default(now())

  // C2: identity = firm + dataset + context + sourceAccountCode.
  @@unique([auditFirmId, id])
  @@unique([auditFirmId, datasetId, sourceAccountingContextId, sourceAccountCode])
  @@index([auditFirmId])
  @@index([auditFirmId, datasetId])
  @@map("dataset_accounts")
}

model JournalEntry {
  id                        String               @id @default(cuid())
  auditFirmId               String
  engagementId              String
  clientCompanyId           String?
  datasetId                 String
  sourceAccountingContextId String?
  fiscalPeriodId            String?
  sourceEntryId             String // present only when source-asserted (never synthesized)
  sourceJournal             String?
  sourceDocumentId          String?
  sourceDocumentNumber      String?
  entryDate                 DateTime?
  groupingBasis             JournalGroupingBasis
  balanceCapability         BalanceCapability
  balanceStatus             BalanceStatus?
  monetaryBasis             MonetaryBasis?
  balanceCurrency           String?
  debitTotal                Decimal?             @db.Decimal(24, 6)
  creditTotal               Decimal?             @db.Decimal(24, 6)
  difference                Decimal?             @db.Decimal(24, 6)
  lineageClass              LineageClass         @default(VERIFIED)
  createdAt                 DateTime             @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, datasetId, sourceEntryId])
  @@index([auditFirmId])
  @@index([auditFirmId, datasetId])
  @@index([auditFirmId, sourceEntryId])
  @@index([auditFirmId, fiscalPeriodId])
  @@index([auditFirmId, sourceAccountingContextId])
  @@map("journal_entries")
}

model JournalLine {
  id                  String                    @id @default(cuid())
  auditFirmId         String
  datasetId           String
  journalEntryId      String? // NULL when NO_RELIABLE_ENTRY_ID (D3/C1: no synthetic entry)
  lineNo              Int
  accountSnapshotId   String // → DatasetAccount (source truth; no mutable accountId here)
  fiscalPeriodId      String?
  transactionDebit    Decimal?                  @db.Decimal(24, 6)
  transactionCredit   Decimal?                  @db.Decimal(24, 6)
  transactionCurrency String?
  functionalDebit     Decimal?                  @db.Decimal(24, 6)
  functionalCredit    Decimal?                  @db.Decimal(24, 6)
  functionalCurrency  String?
  exchangeRate        Decimal?                  @db.Decimal(24, 12)
  exchangeRateSource  String?
  costCenter          String?
  profitCenter        String?
  counterparty        String?
  description         String?
  reference           String?
  documentNumber      String?
  postedByUserId      String?
  sourceType          String?
  sourceLineId        String?
  groupingCapability  JournalGroupingCapability
  lineageClass        LineageClass              @default(VERIFIED)
  importedRecordId    String // real G2 lineage (VERIFIED requires this)
  createdAt           DateTime                  @default(now())

  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([auditFirmId, datasetId])
  @@index([auditFirmId, journalEntryId])
  @@index([auditFirmId, accountSnapshotId])
  @@index([auditFirmId, fiscalPeriodId])
  @@index([auditFirmId, importedRecordId])
  @@map("journal_lines")
}

model TrialBalance {
  id                        String    @id @default(cuid())
  auditFirmId               String
  engagementId              String
  clientCompanyId           String?
  datasetId                 String
  sourceAccountingContextId String?
  fiscalPeriodId            String?
  currency                  String?
  asOfDate                  DateTime?
  createdAt                 DateTime  @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, datasetId])
  @@index([auditFirmId])
  @@index([auditFirmId, datasetId])
  @@map("trial_balances")
}

model TrialBalanceRow {
  id                String       @id @default(cuid())
  auditFirmId       String
  datasetId         String
  trialBalanceId    String
  accountSnapshotId String
  openingDebit      Decimal?     @db.Decimal(24, 6)
  openingCredit     Decimal?     @db.Decimal(24, 6)
  periodDebit       Decimal?     @db.Decimal(24, 6)
  periodCredit      Decimal?     @db.Decimal(24, 6)
  closingDebit      Decimal?     @db.Decimal(24, 6)
  closingCredit     Decimal?     @db.Decimal(24, 6)
  currency          String?
  lineageClass      LineageClass @default(VERIFIED)
  importedRecordId  String
  createdAt         DateTime     @default(now())

  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([auditFirmId, trialBalanceId])
  @@index([auditFirmId, accountSnapshotId])
  @@index([auditFirmId, importedRecordId])
  @@map("trial_balance_rows")
}

// --- VERSIONED AUDIT INTERPRETATION ------------------------------------------

model AccountMapping {
  id               String   @id @default(cuid())
  auditFirmId      String
  datasetAccountId String
  currentVersionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // One mapping per DatasetAccount.
  @@unique([auditFirmId, id])
  @@unique([auditFirmId, datasetAccountId])
  @@index([auditFirmId])
  @@map("account_mappings")
}

model AccountMappingVersion {
  id               String              @id @default(cuid())
  auditFirmId      String
  accountMappingId String
  version          Int
  accountId        String
  basis            AccountMappingBasis
  mappedById       String?
  mappedAt         DateTime            @default(now())
  supersededAt     DateTime? // sole sanctioned post-insert metadata update

  @@unique([auditFirmId, id])
  @@unique([accountMappingId, version])
  @@index([auditFirmId])
  @@index([accountMappingId])
  @@map("account_mapping_versions")
}

// ============================================================================
// G4 — Audit Run & Reproducibility Foundation (PHASE A: persistence only)
// Frozen design ADR-G4-01..23. NO execution behavior in Phase A.
// Fact classes: IMMUTABLE VERSION · IMMUTABLE BUSINESS FACT ·
//   MUTABLE POINTER/MASTER · EXECUTION STATE · REVIEW STATE · TYPED EVIDENCE JOIN.
// Models are relationless (as G2/G3): all FKs (simple + composite tenant),
//   RLS, immutability grants, and CHECK/trigger invariants live in the G4
//   migration SQL. Semantic identity uses stable keys/hashes, never row PKs.
// ============================================================================

enum AuditTestType {
  RULE
  STATISTICAL
  RECONCILIATION
  ACCOUNTING_INTEGRITY
  ANALYTICAL
  DATA_QUALITY
}

enum AuditVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum AuditRunStatus {
  DRAFT
  PREPARING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AuditPreparationStatus {
  PREPARING
  COMPLETE
  FAILED
  ABANDONED
  PUBLISHED
}

enum AuditJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditFailureCode {
  INFRA
  TRANSIENT
  LEASE_LOST
  VALIDATION
  CONFIG
  DETERMINISM
  UNPINNED_DEPENDENCY
}

enum ScopeEligibility {
  ELIGIBLE
  PARTIALLY_ELIGIBLE
  NOT_ELIGIBLE
}

enum ScopeMembershipMode {
  DETERMINISTIC
  MATERIALIZED
}

enum AuditEvidenceType {
  IMPORTED_RECORD
  JOURNAL_LINE
  JOURNAL_ENTRY
  TRIAL_BALANCE_ROW
  DATASET
}

enum AuditReviewState {
  OPEN
  RESOLVED
  DISMISSED
  ESCALATED
}

// --- G4-owned client semantic key (C9; immutable, stable, non-PK) ------------

model AuditClientSemanticKey {
  id              String   @id @default(cuid())
  auditFirmId     String
  clientCompanyId String
  semanticKey     String // G4-minted stable token; never a DB PK, never client-supplied at execution
  assignedById    String?
  assignedAt      DateTime @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, clientCompanyId])
  @@unique([auditFirmId, semanticKey])
  @@index([auditFirmId])
  @@map("audit_client_semantic_keys")
}

// --- MUTABLE POINTER/MASTER --------------------------------------------------

model AuditTest {
  id               String        @id @default(cuid())
  auditFirmId      String
  key              String // firm-stable logical key (semantic identity; not the PK)
  name             String
  nameAr           String
  testType         AuditTestType
  currentVersionId String?
  enabled          Boolean       @default(true)
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, key])
  @@index([auditFirmId])
  @@map("audit_tests")
}

// --- IMMUTABLE VERSION -------------------------------------------------------

model AuditTestVersion {
  id                 String             @id @default(cuid())
  auditFirmId        String
  auditTestId        String
  version            Int
  testType           AuditTestType
  definitionJson     Json
  requirementsJson   Json
  auditRuleVersionId String? // NOT NULL exactly when testType=RULE (CHECK in migration)
  status             AuditVersionStatus @default(DRAFT)
  versionHash        String // integrity attribute — NOT a firm-global uniqueness key
  createdById        String?
  createdAt          DateTime           @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditTestId, version])
  @@index([auditFirmId])
  @@index([auditTestId])
  @@map("audit_test_versions")
}

model AuditRuleVersion {
  id              String             @id @default(cuid())
  auditFirmId     String
  auditRuleId     String
  version         Int
  definitionJson  Json
  thresholdsJson  Json?
  severity        AnomalySeverity    @default(MEDIUM)
  scopeJson       Json?
  status          AuditVersionStatus @default(DRAFT)
  ruleVersionHash String // integrity attribute — NOT a firm-global uniqueness key
  createdById     String?
  createdAt       DateTime           @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditRuleId, version])
  @@index([auditFirmId])
  @@index([auditRuleId])
  @@map("audit_rule_versions")
}

// --- IMMUTABLE BUSINESS FACT / stateful header -------------------------------

model AuditRun {
  id                  String            @id @default(cuid())
  auditFirmId         String
  engagementId        String
  clientCompanyId     String?
  status              AuditRunStatus    @default(DRAFT)
  // Frozen at atomic publish (§8); set-once, guarded by trigger.
  engineBuildVersion  String?
  configFingerprint   String?
  freezeFormatVersion String?
  frozenAt            DateTime?
  freezeGeneration    String? // → exactly one authoritative AuditRunPreparation (composite FK)
  maxAttempts         Int               @default(3)
  failureCode         AuditFailureCode?
  failureDetail       String?
  supersedesRunId     String? // lineage only; never overwrite semantics
  label               String?
  createdById         String?
  executedById        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([auditFirmId, engagementId, status])
  @@map("audit_runs")
}

// --- EXECUTION STATE: preparation generation ---------------------------------

model AuditRunPreparation {
  id                                 String                 @id @default(cuid())
  auditFirmId                        String
  runId                              String
  generationNo                       Int
  status                             AuditPreparationStatus @default(PREPARING)
  pinnedVersionsJson                 Json?
  engineBuildVersionCandidate        String?
  expectedCountsJson                 Json?
  eligiblePopulationFingerprintsJson Json?
  preparationManifestHash            String?
  startedAt                          DateTime               @default(now())
  sealedAt                           DateTime?

  @@unique([auditFirmId, id])
  @@unique([runId, generationNo])
  // Enables the AuditRun.freezeGeneration composite FK (same-run + same-firm proof).
  @@unique([auditFirmId, runId, id])
  @@index([auditFirmId])
  @@index([runId])
  @@map("audit_run_preparations")
}

model AuditRunPrepChunk {
  id                 String   @id @default(cuid())
  auditFirmId        String
  preparationId      String
  auditTestVersionId String
  datasetId          String
  lastSourceRowNo    Int?
  cursorState        Json?
  done               Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@unique([auditFirmId, id])
  @@unique([preparationId, auditTestVersionId, datasetId])
  @@index([auditFirmId])
  @@map("audit_run_prep_chunks")
}

// --- IMMUTABLE BUSINESS FACT: generation-scoped run scope --------------------

model AuditRunDataset {
  id            String       @id @default(cuid())
  auditFirmId   String
  preparationId String
  runId         String
  datasetId     String
  datasetHash   String? // reproducible content id (null only for legacy datasets)
  datasetKind   DatasetKind
  lineageClass  LineageClass
  orderIndex    Int

  @@unique([auditFirmId, id])
  @@unique([preparationId, datasetId])
  @@index([auditFirmId])
  @@index([preparationId])
  @@map("audit_run_datasets")
}

model AuditRunTestVersion {
  id                      String        @id @default(cuid())
  auditFirmId             String
  preparationId           String
  runId                   String
  auditTestVersionId      String
  testType                AuditTestType // denormalized for the RULE↔ruleVersion CHECK
  auditRuleVersionId      String?
  effectiveParametersJson Json
  effectiveParametersHash String
  orderIndex              Int

  @@unique([auditFirmId, id])
  @@unique([preparationId, auditTestVersionId])
  @@index([auditFirmId])
  @@index([preparationId])
  @@map("audit_run_test_versions")
}

model AuditRunAccountMappingPin {
  id                      String @id @default(cuid())
  auditFirmId             String
  preparationId           String
  runId                   String
  datasetAccountId        String
  accountMappingVersionId String
  mappingSemanticHash     String // G4-owned frozen dependency hash over immutable G3 fields

  @@unique([auditFirmId, id])
  @@unique([preparationId, datasetAccountId, accountMappingVersionId])
  @@index([auditFirmId])
  @@index([preparationId])
  @@map("audit_run_account_mapping_pins")
}

model AuditRunScopeResolution {
  id                            String              @id @default(cuid())
  auditFirmId                   String
  preparationId                 String
  runId                         String
  auditTestVersionId            String
  datasetId                     String
  eligibility                   ScopeEligibility
  resolutionAlgorithmVersion    String
  scopePredicateJson            Json?
  scopePredicateHash            String?
  unmetRequirementsJson         Json?
  sourcePopulationCount         Int?
  eligiblePopulationCount       Int?
  eligiblePopulationFingerprint String?
  membershipMode                ScopeMembershipMode

  @@unique([auditFirmId, id])
  @@unique([preparationId, auditTestVersionId, datasetId])
  @@index([auditFirmId])
  @@index([preparationId])
  @@map("audit_run_scope_resolutions")
}

model AuditRunScopeMember {
  id                 String            @id @default(cuid())
  auditFirmId        String
  preparationId      String
  auditTestVersionId String
  datasetId          String
  sourceRowNo        Int // occurrence discriminator — distinguishes identical-content rows
  evidenceType       AuditEvidenceType
  eoiFrameHash       String
  contentHash        String // integrity attribute — NOT the sole identity

  @@unique([auditFirmId, id])
  // Occurrence identity: two identical-content rows (equal contentHash) at
  // different sourceRowNo are two distinct members.
  @@unique([preparationId, auditTestVersionId, datasetId, sourceRowNo])
  @@index([auditFirmId])
  @@index([preparationId, auditTestVersionId, datasetId])
  @@map("audit_run_scope_members")
}

// --- EXECUTION STATE: technical attempts -------------------------------------

model AuditJob {
  id             String            @id @default(cuid())
  auditFirmId    String
  runId          String
  attemptNo      Int
  status         AuditJobStatus    @default(RUNNING)
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  failureCode    AuditFailureCode?
  failureDetail  String?
  createdAt      DateTime          @default(now())

  @@unique([auditFirmId, id])
  @@unique([runId, attemptNo])
  @@index([auditFirmId])
  @@index([auditFirmId, status, leaseExpiresAt])
  @@map("audit_jobs")
}

// --- IMMUTABLE BUSINESS FACT: raw results ------------------------------------

model AuditResult {
  id                          String          @id @default(cuid())
  auditFirmId                 String
  runId                       String
  auditRunTestVersionId       String
  resultKind                  String
  resultCode                  String
  severity                    AnomalySeverity
  score                       Decimal         @db.Decimal(5, 2)
  payloadJson                 Json
  resultOccurrenceFingerprint String
  resultSemanticFingerprint   String // NOT globally unique (cross-run comparison)
  lineageClass                LineageClass    @default(VERIFIED)
  createdAt                   DateTime        @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, runId, resultOccurrenceFingerprint])
  @@index([auditFirmId])
  @@index([auditFirmId, runId])
  @@index([auditFirmId, runId, auditRunTestVersionId])
  @@index([auditFirmId, resultSemanticFingerprint])
  @@map("audit_results")
}

// --- TYPED EVIDENCE JOIN -----------------------------------------------------

model AuditResultEvidence {
  id                String            @id @default(cuid())
  auditFirmId       String
  auditResultId     String
  evidenceType      AuditEvidenceType
  role              String?
  // Exactly one typed FK populated, matching evidenceType (CHECK in migration).
  importedRecordId  String?
  journalLineId     String?
  journalEntryId    String?
  trialBalanceRowId String?
  datasetId         String?
  // Occurrence identity fields (C7).
  sourceRowNo       Int?
  lineNo            Int?
  sourceEntryId     String?
  eoiFrameHash      String?

  @@unique([auditFirmId, id])
  @@index([auditFirmId])
  @@index([auditFirmId, auditResultId])
  @@index([auditFirmId, journalLineId])
  @@index([auditFirmId, importedRecordId])
  @@map("audit_result_evidence")
}

// --- REVIEW STATE (append-only) ----------------------------------------------

model AuditResultReview {
  id            String           @id @default(cuid())
  auditFirmId   String
  auditResultId String
  reviewSeq     Int
  state         AuditReviewState
  reviewedById  String?
  reviewedAt    DateTime         @default(now())
  note          String?

  @@unique([auditFirmId, id])
  @@unique([auditResultId, reviewSeq])
  @@index([auditFirmId])
  @@index([auditFirmId, auditResultId])
  @@map("audit_result_reviews")
}

// ============================================================================
// G5 — PROFESSIONAL DISPOSITION & FINDINGS (additive; relationless FKs → G4/G0).
// All foreign keys, RLS, grants, triggers, CHECKs and the category seed are
// hand-authored in migration 20260903000000_g5_disposition_findings. No
// @relation to frozen G4 models (avoids back-relation churn / phantom diffs).
// ============================================================================

enum AuditDispositionAction {
  MARK_UNDER_REVIEW
  MARK_NOT_RELEVANT
  MARK_FALSE_POSITIVE
  MARK_EXPLAINED
  REQUIRE_INVESTIGATION
  LINK_TO_EXCEPTION
  UNLINK_FROM_EXCEPTION
}

enum AuditResultDispositionKind {
  UNREVIEWED
  UNDER_REVIEW
  DISPOSED
  INVESTIGATING
  LINKED
}

enum AuditExceptionStatus {
  OPEN
  UNDER_INVESTIGATION
  CONCLUDED_WITH_FINDING
  CLOSED_NO_FINDING
}

enum AuditExceptionEventType {
  CREATE
  STATUS
  OWNER
  NARRATIVE
  LINK
  UNLINK
  MERGE
  SPLIT
  REOPEN
}

enum AuditFindingStatus {
  DRAFT
  IN_REVIEW
  CONCLUDED
  WITHDRAWN
}

enum AuditFindingReviewAction {
  SUBMIT
  APPROVE
  RETURN
  WITHDRAW
  SUPERSEDE
}

enum AuditMatterPriority {
  LOW
  MEDIUM
  HIGH
}

/// Derived per-result disposition projection + concurrency anchor (NOT authoritative).
model AuditResultDispositionState {
  id             String                     @id @default(cuid())
  auditFirmId    String
  auditResultId  String
  currentState   AuditResultDispositionKind @default(UNREVIEWED)
  latestEventSeq Int                        @default(0)
  version        Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, auditResultId])
  @@index([auditFirmId])
  @@map("audit_result_disposition_states")
}

/// Authoritative append-only result disposition history.
model AuditResultDispositionEvent {
  id             String                 @id @default(cuid())
  auditFirmId    String
  auditResultId  String
  eventSeq       Int
  action         AuditDispositionAction
  actorId        String
  exceptionId    String?
  note           String?
  idempotencyKey String
  createdAt      DateTime               @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, auditResultId, eventSeq])
  @@unique([auditFirmId, auditResultId, actorId, action, idempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, auditResultId])
  @@map("audit_result_disposition_events")
}

/// Engagement-scoped professional matter (mutable header; authoritative history in events).
model AuditException {
  id                     String               @id @default(cuid())
  auditFirmId            String
  engagementId           String
  matterCorrelationKey   String?
  currentStatus          AuditExceptionStatus @default(OPEN)
  currentOwnerId         String?
  currentTitle           String
  currentTitleAr         String?
  currentDescription     String?
  priority               AuditMatterPriority  @default(MEDIUM)
  membershipFingerprint  String?
  latestEventSeq         Int                  @default(0)
  version                Int                  @default(0)
  createdById            String
  creationIdempotencyKey String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, creationIdempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, engagementId])
  @@index([auditFirmId, matterCorrelationKey])
  @@map("audit_exceptions")
}

/// Authoritative append-only single Exception timeline (incl. LINK/UNLINK).
model AuditExceptionEvent {
  id                String                  @id @default(cuid())
  auditFirmId       String
  exceptionId       String
  engagementId      String
  eventSeq          Int
  eventType         AuditExceptionEventType
  actorId           String
  auditResultId     String?
  toStatus          AuditExceptionStatus?
  toOwnerId         String?
  title             String?
  titleAr           String?
  description       String?
  targetExceptionId String?
  note              String?
  idempotencyKey    String
  createdAt         DateTime                @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, exceptionId, eventSeq])
  @@unique([auditFirmId, exceptionId, actorId, eventType, idempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, exceptionId])
  @@map("audit_exception_events")
}

/// Active result-membership projection (authoritative history = AuditExceptionEvent LINK/UNLINK).
model AuditExceptionResultLink {
  id            String   @id @default(cuid())
  auditFirmId   String
  exceptionId   String
  engagementId  String
  auditResultId String
  active        Boolean  @default(true)
  lastEventSeq  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, exceptionId, auditResultId])
  @@index([auditFirmId])
  @@index([auditFirmId, exceptionId])
  @@index([auditFirmId, auditResultId])
  @@map("audit_exception_result_links")
}

/// Finding header (1:N under an Exception). Content is versioned; status/currentVersionId are projections.
model AuditFinding {
  id                     String             @id @default(cuid())
  auditFirmId            String
  engagementId           String
  exceptionId            String
  currentStatus          AuditFindingStatus @default(DRAFT)
  currentVersionId       String?
  latestReviewSeq        Int                @default(0)
  version                Int                @default(0)
  createdById            String
  creationIdempotencyKey String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, creationIdempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, exceptionId])
  @@index([auditFirmId, engagementId])
  @@map("audit_findings")
}

/// Immutable, versioned professional Finding content snapshot.
model AuditFindingVersion {
  id                        String   @id @default(cuid())
  auditFirmId               String
  findingId                 String
  versionNo                 Int
  category                  String
  condition                 String
  criteria                  String
  cause                     String
  effect                    String
  auditorConclusion         String
  recommendation            String?
  observedAmount            Decimal? @db.Decimal(24, 6)
  observedCurrency          String?
  estimatedExposureAmount   Decimal? @db.Decimal(24, 6)
  estimatedExposureCurrency String?
  preparedById              String
  preparedAt                DateTime @default(now())
  contentHash               String
  idempotencyKey            String?
  createdAt                 DateTime @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, findingId, versionNo])
  @@unique([auditFirmId, findingId, idempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, findingId])
  @@map("audit_finding_versions")
}

/// Authoritative append-only Finding review history; approval binds to an exact version.
model AuditFindingReviewEvent {
  id               String                   @id @default(cuid())
  auditFirmId      String
  findingId        String
  findingVersionId String
  eventSeq         Int
  action           AuditFindingReviewAction
  actorId          String
  note             String?
  idempotencyKey   String
  createdAt        DateTime                 @default(now())

  @@unique([auditFirmId, id])
  @@unique([auditFirmId, findingId, eventSeq])
  @@unique([auditFirmId, findingId, actorId, action, idempotencyKey])
  @@index([auditFirmId])
  @@index([auditFirmId, findingId])
  @@map("audit_finding_review_events")
}

/// Controlled global finding-category taxonomy (seeded; not tenant-scoped; read-only to app).
model AuditFindingCategoryRef {
  code      String  @id
  label     String
  labelAr   String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("audit_finding_category_refs")
}
