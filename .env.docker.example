# =============================================================================
# إعدادات التشغيل عبر Docker — انسخ هذا الملف إلى .env.docker وعبّئ القيم.
#   cp .env.docker.example .env.docker
# لا ترفع .env.docker إلى git (مُستبعَد في .gitignore).
#
# مهم: استخدم كلمات مرور بأحرف وأرقام فقط (تجنّب : / @ # مسافات) لأنها تدخل
# ضمن روابط الاتصال أدناه أيضًا، ويجب أن تتطابق في الموضعين.
# =============================================================================

# --- كلمة مرور مالك قاعدة البيانات (المستخدم audit) ---
POSTGRES_PASSWORD=change_me_owner

# --- كلمات مرور أدوار التشغيل (يجب أن تطابق ما في الروابط أدناه) ---
AUDIT_APP_PASSWORD=change_me_app
AUDIT_DISPATCH_PASSWORD=change_me_dispatch

# --- روابط الاتصال: المضيف = خدمة db داخل شبكة Docker، المنفذ الداخلي 5432 ---
# التشغيل (غير المالك، خاضع لعزل الصفوف RLS):
DATABASE_URL=postgresql://audit_app:change_me_app@db:5432/audit_dashboard?schema=public
# الترحيلات/الزرع (المالك):
DIRECT_DATABASE_URL=postgresql://audit:change_me_owner@db:5432/audit_dashboard?schema=public
# المُشغّل الخلفي (محدِّد العمل فقط):
DISPATCH_DATABASE_URL=postgresql://audit_dispatch:change_me_dispatch@db:5432/audit_dashboard?schema=public

# --- المصادقة (إلزامية في الإنتاج) ---
# ولّد مفتاحًا قويًّا: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
AUTH_REQUIRED=true
# عنوان الوصول من المتصفح (IP الخادم + المنفذ) للسماح بطلبات تغيير الحالة:
ALLOWED_ORIGINS=http://localhost:3000

# --- تخزين الملفات المصدرية (وحدة تخزين دائمة داخل الحاوية) ---
STORAGE_PROVIDER=local-fs
STORAGE_LOCAL_DIR=/data/object-store

# --- اختياري: تحليل المستندات عبر Claude OCR (بدونه يُستخدم محلّل بديل) ---
ANTHROPIC_API_KEY=

# --- الزرع الأوّلي: true لزرع الحسابات التجريبية أول مرة (يتم فقط إن كانت
#     القاعدة فارغة). يمكن تركها true بأمان — لن تتكرّر. ---
RUN_SEED=true
